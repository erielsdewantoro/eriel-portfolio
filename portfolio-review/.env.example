# Copy to .env.local for local overrides. Never commit real secrets.
# Optional: your final public address (custom domain). On Vercel you can
# leave this unset and the *.vercel.app address is used automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: Google Search Console "HTML tag" verification token (only the
# content value of the meta tag, not the whole tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
